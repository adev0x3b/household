# Editors read this file to match the linters before they run: two spaces,
# UTF-8, a final newline and no trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown ends a line with two spaces to break it.
[*.md]
trim_trailing_whitespace = false
