# Kamal's secrets (config/deploy.yml), read before .kamal/secrets.<destination>.
# References only, never values: CI passes the values as environment
# variables (.github/workflows/kamal.yml, from the destination's GitHub
# environment, or the repository's secrets while it is private); by
# hand on the production machine the command after `||` finds them.

# GHCR: the job's GITHUB_TOKEN in CI, your own token by hand.
KAMAL_REGISTRY_PASSWORD=$(printenv KAMAL_REGISTRY_PASSWORD || gh auth token)

# A destination's keys, each passed only where the environment has it
# (config/deploy.yml's env.secret): by hand, bin/kamal loads
# ~/.config/household/<destination>.env into the environment first; in CI
# the destination's GitHub environment holds them. An unset one reads as "".
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
GOOGLE_BOOKS_API_KEY=${GOOGLE_BOOKS_API_KEY}
DEMO_PASSWORD=${DEMO_PASSWORD}
DEPLOY_DISPATCH_TOKEN=${DEPLOY_DISPATCH_TOKEN}
SMTP_PASSWORD=${SMTP_PASSWORD}
