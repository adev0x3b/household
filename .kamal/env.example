# What config/deploy.yml needs about this installation, for bin/kamal run by
# hand: bin/provision asks for it and writes .kamal/env (kept out of git), or
# copy this there and fill it in. The Deploy workflow
# sets the same names from the repository's variables (the deployment runbook).

# The machine the destinations run on, as SSH reaches it (a tailnet name).
DEPLOY_HOST=server.your-tailnet.ts.net
# Who owns the image on GHCR (ghcr.io/<owner>/household): the repository's owner.
KAMAL_REGISTRY_USERNAME=your-github-user
# The repository the Deploy workflow runs in, for bin/provision and the app's
# delivery console.
GITHUB_REPOSITORY=your-github-user/household
# The code's repository, where that is another one: the pipeline then runs
# from a private repository of its own (the deployment runbook,
# "A private pipeline").
#SOURCE_REPOSITORY=your-github-user/household
# Dev's previews are then that repository's private package (config/deploy.dev.yml).
#PREVIEW_PACKAGE=household-pipeline
# Each destination's public name (the Cloudflare Tunnel's hostnames).
PRODUCTION_HOST=example.com
STAGING_HOST=staging.example.com
DEV_HOST=dev.example.com
# The public demo's, where this installation has one (config/deploy.demo.yml): /demo
# on every other copy sends the visitor there.
#DEMO_HOST=demo.example.com
# A path the app lives under, with no trailing slash; unset, the domain's root.
#MOUNT_PATH=/love
# The household's clock, an IANA name, for pages before sign-in and work done
# for no one in particular (each person's own comes from their browser).
#TIME_ZONE=Europe/Rome

# A destination's own settings — what it allows, the assistant's provider and
# keys — are ~/.config/household/<destination>.env, which bin/kamal -d <destination>
# loads before this file (the deployment runbook, "Settings, per destination").
