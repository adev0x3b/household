#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'kamal' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

bundle_binstub = File.expand_path("bundle", __dir__)

if File.file?(bundle_binstub)
  if File.read(bundle_binstub, 300).include?("This file was generated by Bundler")
    load(bundle_binstub)
  else
    abort("Your `bin/bundle` was not generated by Bundler, so this binstub cannot run.
Replace `bin/bundle` by running `bundle binstubs bundler --force`, then run this command again.")
  end
end

require "rubygems"
require "bundler/setup"

# This installation's particulars, which config/deploy.yml reads from the
# environment: the destination's own settings, ~/.config/household/<destination>.env
# (what it allows, its keys: the deployment runbook, "Settings, per destination"),
# then .kamal/env, kept out of git (.kamal/env.example lists them). Dotenv
# keeps the first value it meets and never overwrites the environment, so
# the destination's file wins over .kamal/env, and the Deploy workflow's
# environment — the same names, from the repository's variables and the
# destination's — over both.
require "dotenv"
destination = ARGV.each_cons(2).find { |flag, _| %w[-d --destination].include?(flag) }&.last ||
              ARGV.filter_map { _1[/\A(?:-d=|--destination=)(.+)\z/, 1] }.first
files = [ File.expand_path("../.kamal/env", __dir__) ]
files.unshift(File.join(Dir.home, ".config", "household", "#{destination}.env")) if destination
Dotenv.load(*files)

load Gem.bin_path("kamal", "kamal")
