#!/usr/bin/env bash
# What Rails needs in production and nothing else can make: the secret key
# base, the Active Record encryption keys (Assistant::Setting's and
# Platform::Setting's secrets) and the Web Push pair (VAPID). Made once, on
# the first boot (bin/docker-entrypoint), into /rails/secrets/env — a volume
# per destination, household_secrets in production (config/deploy.*.yml) —
# in dotenv form, which config/application.rb reads in every process of the
# container (the web server, the jobs, a console), so a deploy needs no
# application secrets at all.
#
# Nothing is made when RAILS_MASTER_KEY is given (config/credentials.yml.enc
# holds the same keys then). A value already in the environment (Kamal's
# env) wins over the file's: Dotenv never overwrites.
#
# Losing the volume loses the keys: what was encrypted with them can't be
# read back, and every device must turn push on again (the deployment
# runbook says how to back it up).
set -euo pipefail

SECRETS_DIR="${SECRETS_DIR:-/rails/secrets}"
FILE="$SECRETS_DIR/env"

[ -z "${RAILS_MASTER_KEY:-}" ] || exit 0
[ ! -f "$FILE" ] || exit 0

mkdir -p "$SECRETS_DIR"
exec 9> "$SECRETS_DIR/.lock"
flock 9
[ ! -f "$FILE" ] || exit 0 # made by the other container in the meantime

umask 077
TMP="$(mktemp "$SECRETS_DIR/.env.XXXXXX")"
bundle exec ruby -rsecurerandom -rtime -rweb-push -e '
  vapid = WebPush.generate_key
  puts "# Made by bin/docker-secrets on #{Time.now.utc.iso8601}. Read by config/application.rb; the environment wins."
  puts "SECRET_KEY_BASE=#{SecureRandom.hex(64)}"
  puts "ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=#{SecureRandom.alphanumeric(32)}"
  puts "ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=#{SecureRandom.alphanumeric(32)}"
  puts "ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=#{SecureRandom.alphanumeric(32)}"
  puts "VAPID_PUBLIC_KEY=#{vapid.public_key}"
  puts "VAPID_PRIVATE_KEY=#{vapid.private_key}"
' > "$TMP"
mv "$TMP" "$FILE"
echo "bin/docker-secrets: made $FILE"
