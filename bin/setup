#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # The lint tools for JavaScript and stylesheets, which bin/ci runs. The app
  # itself runs without Node, so a machine without it is told rather than
  # stopped.
  if system("command -v npm > /dev/null")
    system! "npm ci --ignore-scripts --no-audit --no-fund"
  else
    puts "npm isn't installed: the app runs, but bin/ci can't lint JavaScript and stylesheets without Node 20 or later."
  end

  # The app reads its development settings from .env. A first run starts
  # from the example; an .env already there is never overwritten.
  unless File.exist?(".env")
    puts "\n== Copying .env.example to .env =="
    FileUtils.cp ".env.example", ".env"
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    $stdout.flush
    exec "bin/dev"
  end
end
