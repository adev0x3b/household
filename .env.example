# Household's environment variables. In development, copy this to .env (the
# dotenv gem loads it). In production none is needed here: each Kamal
# destination makes its own secrets on its first boot (bin/docker-secrets),
# config/deploy*.yml sets the rest, and the admin keeps the keys on
# /admin/settings and /assistant/settings. See docs/architecture/delivery.md.

# --- Development (.env) -----------------------------------------------------

# The local Postgres role and its password (config/database.yml).
HOUSEHOLD_DATABASE_USERNAME=household
HOUSEHOLD_DATABASE_PASSWORD=

# With the database of compose.dev.yml, which needs the password above: the
# app reaches it over TCP rather than the local socket.
#PGHOST=localhost
#PGPORT=5432

# The assistant until an admin saves /assistant/settings (app/models/assistant.rb).
ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
ASSISTANT_CONTEXT_TOKENS=12288
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Web Push (bin/rails push:vapid_keys). Unset, push is off and the bell works as before.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com

# Also settable on /admin/settings, which wins when saved.
#GOOGLE_BOOKS_API_KEY=       the bookshelf's second ISBN source
#DEPLOY_DISPATCH_TOKEN=      /admin/deployment's buttons (a fine-grained GitHub token, Actions: read & write)
#DEMO_PASSWORD=demo-household

# The installation's limits (Platform): on and unlimited unless said otherwise.
# They are set on /admin/settings; one named here is where the page starts,
# until the settings are first saved.
#ASSISTANT=off               no assistant: its tab is gone, its pages are a 404 (the admin's settings page stays)
#UPLOADS=off                 nobody uploads a file or makes a public link; what is there is seen and downloaded
#PICTURES=off                no pictures in messages, no photos to the assistant
#INVITATIONS=off             members invite nobody (the admin still does)
#PUSH_NOTIFICATIONS=off      no device subscribes, even with VAPID keys
#ASSISTANT_MESSAGES_PER_DAY=30   what a household may ask the assistant in a day
#BOOK_LOOKUPS_PER_DAY=50     the Open Library lookups a household gets in a day
#OPEN_ACCOUNTS=alex.demo,sam.demo,robin.demo   the accounts anyone enters without a password
#FILES_QUOTA=50GB            what a household may keep in Files (Platform.files_quota; "512MB" on a small volume)
#RELEASE_CHECK=off           the copy never asks GitHub for a newer release
#HOUSEHOLD_SIZE=20           the people a household may hold, invitations waiting included
#INVITATIONS_PER_MEMBER=5    the people one member may invite into their household

# Environment only.
#MOUNT_PATH=/love            a path to live under; unset, the domain's root
#FORCE_SSL=off               where nothing terminates HTTPS in front: plain HTTP works in a browser; installing as an app and push need HTTPS
#DEV_TUNNEL_HOST=            a tunnel's hostname to this server, so a phone reaches it over HTTPS (camera, push)

# --- Production -----------------------------------------------------------------
# Nothing here. What a deploy needs lives in the repository's secrets and
# variables (bin/provision sets them; the deployment runbook,
# "First time"), and for bin/kamal by hand on the production machine in
# ~/.config/household/<destination>-postgres-password plus `gh auth token`
# (.kamal/secrets-common, .kamal/secrets.<destination>). A destination's own
# settings — the limits above, the assistant's provider, model and Ollama
# address, its keys — are ~/.config/household/<destination>.env by hand and
# its GitHub environment's variables and secrets in CI, under the same names
# (the deployment runbook, "Settings, per destination"). A copy without the
# pipeline (compose.yml, docs/self-hosting.md) reads the same names from its
# household.env, which install.sh writes with where it is reached: APP_HOST,
# BIND, PORT, TLS_PORT, TLS_DOMAIN, FORCE_SSL, TUNNEL_TOKEN, and the
# database's POSTGRES_PASSWORD.
