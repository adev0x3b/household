# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore development files
/.devcontainer

# Ignore how the image is built and deployed: it doesn't need either.
/.dockerignore
/Dockerfile*
/compose.yml
/install.sh
/.kamal
/config/deploy*.yml
/lib/provision*
/bin/kamal
/bin/provision
/bin/held-migrations
/bin/release-stopped

# Beside the code but not part of what runs: the tests and their fixtures
# (which carry other people's work under licenses the image would then have
# to honour), the editors' files, the docs and stray screenshots.
/test
/docs
/*.png
/.ruby-lsp
/.rubymate
/.vscode
